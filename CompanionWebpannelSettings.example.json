{
  "version": "1.7.0",
  "server": {
    "port": 8080
  },
  "activeHostId": "my-companion",
  "hosts": [
    {
      "id": "my-companion",
      "name": "My Companion",
      "host": "192.168.1.100",
      "satellite": {
        "wsPort": 16623
      },
      "notes": "Main Companion instance",
      "autoConnect": true
    }
  ],
  "panels": [
    {
      "id": "panel-main",
      "name": "My Panel",
