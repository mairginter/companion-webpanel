      "canvas": {
        "width": 1280,
        "height": 720,
        "background": "#1a1d23"
      },
      "elements": [
        {
          "id": "btn-example",
          "type": "companionButton",
          "x": 20,
          "y": 20,
          "w": 100,
          "h": 100,
          "z": 0,
          "ref": {
            "hostId": "my-companion",
            "page": 1,
            "row": 0,
            "col": 0
          },
          "render": {
            "centerBitmap": true,
            "bitmapSize": 72,
            "enforceMinSize": true,
            "showText": true,
            "textAlign": "bottom",
            "borderRadius": 8,
            "opacity": 1
          }
        }
      ]
    }
